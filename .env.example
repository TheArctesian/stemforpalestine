# Postgres connection string. Neon in production (use the pooled "-pooler" host);
# a local database works for development, e.g. postgres://localhost/stemforpalestine_dev
DATABASE_URL="postgres://user:password@host:port/db-name"

# Signs unsubscribe links and form tokens, and hashes IP addresses. Any long random string;
# generate one with `openssl rand -hex 32`. Changing it invalidates links in emails already sent.
APP_SECRET=""
