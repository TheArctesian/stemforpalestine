# Postgres connection string. Neon in production (use the pooled "-pooler" host);
# a local database works for development, e.g. postgres://localhost/stemforpalestine_dev
DATABASE_URL="postgres://user:password@host:port/db-name"

# Signs unsubscribe links and form tokens, and hashes IP addresses. Any long random string;
# generate one with `openssl rand -hex 32`. Changing it invalidates links in emails already sent.
APP_SECRET=""

# Email (Resend). Without RESEND_API_KEY, development logs emails to the console instead.
RESEND_API_KEY=""
# Signing secret of the Resend webhook pointed at /api/webhooks/resend (bounces and complaints).
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="STEM4Palestine <hello@mail.stem4pal.org>"
EMAIL_REPLY_TO="info@stem4pal.org"
# "console" forces logging instead of sending, e.g. on preview deployments.
EMAIL_PROVIDER=""

# Vercel Blob, for images in emails and events. Development without it saves to static/uploads-dev/.
BLOB_READ_WRITE_TOKEN=""
